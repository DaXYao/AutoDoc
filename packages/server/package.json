{
  "name": "@autodoc/server",
  "version": "0.1.0",
  "type": "module",
  "description": "AutoDoc 本地服务：Fastify REST API + docgen CLI（serve/export）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "docgen": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/cli.ts serve --root ../..",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@autodoc/core": "workspace:*",
    "@autodoc/shared-types": "workspace:*",
    "@fastify/static": "^8.0.3",
    "chokidar": "^4.0.1",
    "commander": "^13.0.0",
    "fastify": "^5.2.0",
    "picomatch": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/picomatch": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
