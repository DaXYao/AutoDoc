{
  "name": "@autodoc/core",
  "version": "0.1.0",
  "type": "module",
  "description": "AutoDoc 核心引擎：解析、分类、建图、注释块、变更追踪、存储适配",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@autodoc/shared-types": "workspace:*",
    "@vscode/tree-sitter-wasm": "^0.0.5",
    "ajv": "^8.17.1",
    "cosmiconfig": "^9.0.0",
    "picomatch": "^4.0.2",
    "web-tree-sitter": "^0.25.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/picomatch": "^4.0.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
