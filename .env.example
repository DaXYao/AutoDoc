# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略，切勿提交真实密钥。
# 也可使用真实环境变量（优先级高于 .env）。
#
# 多 KEY 规则：可以同时保留 DeepSeek 与 MiMo 的 KEY。
# 按本文件「从上到下第一个有值的 *_API_KEY」生效；注释/删除即自动切到下一个。
# AUTODOC_AI_PROVIDER=deepseek|mimo 可强制指定（仍使用该 provider 自己的 KEY）。
#
# ───────────────────────── 方案 A：DeepSeek（按量付费） ─────────────────────────
# DEEPSEEK_API_KEY=sk-xxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
#
# ───────────────────── 方案 B：小米 MiMo（Token Plan 订阅） ─────────────────────
# 订阅套餐后，在 Token Plan 页面复制专属 Base URL 与 tp-/ttp- KEY。
# 默认模型 mimo-v2.6-flash；亦可换 mimo-v2.6-pro（更强、消耗更高）。
# MIMO_API_KEY=tp-xxxxx
# MIMO_MODEL=mimo-v2.6-flash
# 可选：区域端点；默认国内 https://token-plan-cn.xiaomimimo.com
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com
# 可选：MiMo 默认关闭思考（结构化 JSON 更稳、更省）；需要推理时设为 enabled
# AUTODOC_AI_THINKING=disabled
#
# ───────────────────── 通用变量（覆盖供应商变量，兼容其它 OpenAI 网关） ─────────────────────
# AUTODOC_AI_PROVIDER=mimo            # deepseek | mimo（可省略，按 base/model/key 自动识别）
# AUTODOC_AI_API_KEY=tp-xxxxx
# AUTODOC_AI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1   # 可带 /v1，会自动归一化
# AUTODOC_AI_MODEL=mimo-v2.6-flash
# AUTODOC_AI_MAX_TOKENS_FIELD=max_completion_tokens   # 一般不需要手动设置
